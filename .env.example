# Copy to .env for local development (python-dotenv is NOT required: export these or use `set -a; . ./.env`).
# On Toolforge use `toolforge envvars create NAME` instead of a file.

# 1 = local development (http allowed, insecure fallback key). Never set on Toolforge.
DW_DEV=1
BASE_URL=http://localhost:5000

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Wikimedia OAuth 2.0 consumer (confidential). Register at
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Optional
# DATA_DIR=./var
# SESSION_DAYS=14
# WRITES_PER_MINUTE=120
# CONTACT=https://github.com/wikimedia-biodiversity/dataweaver
